diff -ruN wget-1.20.3/src/aros.c wget-1.20.3.aros/src/aros.c
--- wget-1.20.3/src/aros.c	1970-01-01 01:00:00.000000000 +0100
+++ wget-1.20.3.aros/src/aros.c	2026-08-30 16:15:34.002239783 +0200
@@ -0,0 +1,53 @@
+/* AROS-specific initialization for wget: open bsdsocket.library.
+   Modeled on the AROS port of cURL (lib/aros.c).  */
+
+#ifdef __AROS__ /* AROS */
+
+#include <errno.h>
+#include <aros/symbolsets.h>
+#include <exec/libraries.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/bsdsocket.h>
+#include <bsdsocket/socketbasetags.h>
+
+struct Library * __attribute__((weak)) SocketBase = NULL;
+
+static void
+aros_cleanup (void)
+{
+  if (SocketBase)
+    {
+      CloseLibrary (SocketBase);
+      SocketBase = NULL;
+    }
+}
+
+static BOOL
+aros_init (void)
+{
+  if (!SocketBase)
+    SocketBase = OpenLibrary ("bsdsocket.library", 4);
+
+  if (!SocketBase)
+    {
+      Printf ("No TCP/IP Stack running!\n", "");
+      return FALSE;
+    }
+
+  if (SocketBaseTags (
+        SBTM_SETVAL (SBTC_ERRNOPTR (sizeof (errno))), (IPTR) &errno,
+        SBTM_SETVAL (SBTC_LOGTAGPTR), (IPTR) "wget",
+        TAG_DONE))
+    {
+      Printf ("SocketBaseTags ERROR\n", "");
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+ADD2INIT (aros_init, -50)
+ADD2EXIT (aros_cleanup, -50)
+
+#endif /* __AROS__ */
diff -ruN wget-1.20.3/src/connect.c wget-1.20.3.aros/src/connect.c
--- wget-1.20.3/src/connect.c	2026-08-30 16:15:33.878937554 +0200
+++ wget-1.20.3.aros/src/connect.c	2026-08-30 16:15:34.006281916 +0200
@@ -62,6 +62,16 @@
 
 #include <stdint.h>
 
+#ifdef __AROS__
+/* AROS's posixc read()/write()/close() operate on dos.library handles,
+   which do not work on bsdsocket (lwIP) socket handles, so plain socket
+   I/O must use the Amiga bsdsocket recv()/send()/CloseSocket() instead.
+   (HTTPS still works because OpenSSL does its own socket I/O.)  */
+# define read(fd, buf, cnt) recv (fd, buf, cnt, 0)
+# define write(fd, buf, cnt) send (fd, buf, cnt, 0)
+# define close(fd) CloseSocket (fd)
+#endif
+
 /* Define sockaddr_storage where unavailable (presumably on IPv4-only
    hosts).  */
 
